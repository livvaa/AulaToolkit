{
  "name": "aula-toolkit",
  "productName": "AULA Toolkit",
  "version": "0.2.1-beta.1",
  "description": "Unofficial open-source control app for AULA keyboards and mice",
  "main": "./out/main/index.js",
  "author": "Livvaa",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "screenshots": "electron-vite build && node scripts/screenshots.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-hid": "^3.1.2"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "zustand": "^5.0.6"
  }
}
